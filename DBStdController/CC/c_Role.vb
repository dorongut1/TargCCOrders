    Me.Clear() 
    
 
    Dim pType As Type = Me.GetType 
    Try 
      Dim pXmlSerializer As New System.Xml.Serialization.XmlSerializer(pType) 
      Dim pStreamReader As New IO.StringReader(vXML) 
      Dim pRoles As csRoleCol = CType(pXmlSerializer.Deserialize(pStreamReader), csRoleCol) 
      For Each pRole As csRole In pRoles 
        Me.Add(pRole) 
        _Clean.Add(pRole.ID) 
      Next 
      pFault.SetOK() 
    Catch ex As Exception 
      pFault.LogException(ex, vXML, "TRGT-Role-130515-1329", vRequester) 
    End Try 
 
    Return pFault 
  End Function 
 
