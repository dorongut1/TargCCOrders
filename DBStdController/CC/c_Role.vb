#Region "Load Collection"  
  Friend Function LoadMeFromIDataReader(vReader As IDataReader, vRequester As clsRequester) As clsFault Implements ITargCCDataReaderUser.LoadMeFromIDataReader 
    Dim pFunctionParameters As String = ""  
    Dim pFault As New clsFault
  
    Dim pRole As csRole
  
    While vReader.Read()
      pRole = New csRole(_WithParents) 
      pFault = pRole.LoadMeFromIDataReader(vReader, vRequester) : If Not pFault.isOK Then Return pFault 
       
      If pRole.ID = 1 AndAlso pRole.Name <> "Master" Then Throw New Exception("Master must have an ID of 1 in c_Roles") 
      If pRole.Name = "Master" AndAlso pRole.ID <> 1 Then Throw New Exception("Master must have an ID of 1 in c_Roles") 
      Me.Add(pRole)
      If Not _FilledFromSumOnTheFly Then _Clean.Add(pRole.ID) 
    End While
    vRequester.Tag = "" 
  
    _IsCleanForXML = False 
     
    Return pFault
  
  End Function
  
  Private Function LoadMeFromDBCache(ByVal vCachedRoleCol As csRoleCol, ByVal vRequester As clsRequester) As clsFault 
    Dim pFunctionParameters As String = "" 
    Dim pFault As New clsFault 
 
    Try 
      Dim pRole As csRole 
 
      For Each pCachedRole As csRole In vCachedRoleCol 
        pCachedRole.SetWithParents(_WithParents) 
        pRole = New csRole(pCachedRole) 
        If _WithParents = clsEnums.enmLoadParent.DoNotLoad Then 
          pRole.BaseRoleText = "." 
        End If 
        pRole.ccStatus = clsEnums.enmObjectStatus.Clean 
        Me.Add(pRole) 
        If Not _FilledFromSumOnTheFly Then _Clean.Add(pRole.ID) 
      Next 
      If _WithParents = clsEnums.enmLoadParent.EntireObject Then 
        pFault = LoadParents(vRequester) 
        If pFault.isOK = False Then Return pFault 
      End If 
      pFault.SetOK() 
      Catch ex As Exception 
        pFault.LogException(ex, pFunctionParameters, "TRGT-Role-121122-1513", vRequester) 
      End Try 
   
    Return pFault 
  End Function 
#End Region 
   
  Private Overloads Sub Clear() 
    MyBase.Clear() 
    _Tag = "" 
    _Clean = New List(Of Long) 
    _FilledFromSumOnTheFly = False 
    
    _SortedDictionaryForFindByID = New Dictionary(Of Long, csRole) 
    _RecreateDictionaryForFindByID = False 
    _SortedDictionaryForFindByName = New Dictionary(Of String, csRole)(StringComparer.OrdinalIgnoreCase) 
    _RecreateDictionaryForFindByName = False 
  End Sub 
  
  Private Sub CreateEmpty() 
    _Tag = "" 
    _IsCleanForXML = False 
    _Clean = New List(Of Long) 
    _FilledFromSumOnTheFly = False 
 
    _SortedDictionaryForFindByID = New Dictionary(Of Long, csRole) 
    _SortedDictionaryForFindByName = New Dictionary(Of String, csRole)(StringComparer.OrdinalIgnoreCase) 
 
    Static pWasRun As Boolean = False 
    If pWasRun = False Then 
      _WithParents = clsEnums.enmLoadParent.UD 
      bHasParents = True 
      bHasLocalizedFields = False 
      bCanHave0AsPrimaryKey = False 
      pWasRun = True 
    End If 
  End Sub 
  
End Class 
  
