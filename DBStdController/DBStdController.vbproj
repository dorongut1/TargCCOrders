<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <RootNamespace>TargCCOrders.DataController</RootNamespace>
	  <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>TargCCOrders.DBStdController</AssemblyName>
    <OptionStrict>On</OptionStrict>
    <ImportedNamespaces>SYSTEM.DATA=False,System.Data=False,Microsoft.VisualBasic=True,System=True,System.Collections=True,System.Collections.Generic=True,System.Diagnostics=True,System.Linq=True,System.Xml.Linq=True,System.Threading.Tasks=True,DBStdController=True</ImportedNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="9.0.8" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="9.0.8" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.8" />
    <PackageReference Include="System.Management" Version="9.0.8" />
  </ItemGroup>

  <ItemGroup>
    <Import Include="SYSTEM.DATA" />
    <Import Include="System.Data" />
  </ItemGroup>

</Project>
