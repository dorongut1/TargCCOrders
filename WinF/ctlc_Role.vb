  Private Sub lblBaseRole_DoubleClick(ByVal sender As Object, ByVal e As System.EventArgs) Handles lblBaseRole.DoubleClick 
    If _Role.BaseRoleID = 0 Then Exit Sub 
    Cursor = Cursors.WaitCursor 
 
    Dim pHandled As Boolean = False 
    If _LoadParameters.EnableParentLinks.Find(Function(p) p = csRole.enmParentProperty.BaseRole) = csRole.enmParentProperty.BaseRole Then 
      If _Role.BaseRoleID <> 0 Then RaiseEvent evtParentChosen(csRole.enmParentProperty.BaseRole, _Role.BaseRoleID, pHandled) 
    End If 
 
    If pHandled = False Then 
      Dim fPopup As New frmPopup() 
      fPopup.Text = "BaseRole Detail" 
      fPopup.LoadControl("ctlc_Role", _Role.BaseRoleID, _Requester) 
      Cursor = Cursors.Default 
      fPopup.ShowDialog() 
    Else 
      Cursor = Cursors.Default 
    End If 
  End Sub 
  Private Sub lblBaseRole_MouseEnter(ByVal sender As Object, ByVal e As System.EventArgs) Handles lblBaseRole.MouseEnter 
    If _LoadParameters.EnableParentLinks.Find(Function(p) p = csRole.enmParentProperty.BaseRole) <> csRole.enmParentProperty.BaseRole Then Exit Sub 
    lblBaseRole.ForeColor = Color.Brown 
    'lblBaseRole.Font = New Font(lblBaseRole.Font.Name, lblBaseRole.Font.SizeInPoints, FontStyle.Underline) 'makes the page jump to the top!! 
    lblBaseRole.BackColor = ccHelper.InvertColour(lblBaseRole.ForeColor) 'did this instead 
    lblBaseRole.Cursor = Cursors.Hand 
  End Sub 
  Private Sub lblBaseRole_MouseLeave(ByVal sender As Object, ByVal e As System.EventArgs) Handles lblBaseRole.MouseLeave 
    If _LoadParameters.EnableParentLinks.Find(Function(p) p = csRole.enmParentProperty.BaseRole) <> csRole.enmParentProperty.BaseRole Then Exit Sub 
    lblBaseRole.ForeColor = Color.Brown 
    'lblBaseRole.Font = New Font(lblBaseRole.Font.Name, lblBaseRole.Font.SizeInPoints) 'makes the page jump to the top!! 
    lblBaseRole.BackColor = Me.BackColor 'did this instead 
    lblBaseRole.Cursor = Cursors.Default 
  End Sub 
 
