          pUserLoginKey = New csUserLoginKey(pBytes, pFault, vRequester) : If Not pFault.isOK Then Return pFault 
          pVariableName = "pReload" 
          pReload = pReader.ReadBoolean 
          pReader.Close() 
        End Using 
        pMemoryStream.Close() 
      End Using 
    Catch ex As Exception 
