          pUser = New csUser(pBytes, pFault, vRequester) : If Not pFault.isOK Then Return pFault 
          pVariableName = "pReload" 
          pReload = pReader.ReadBoolean 
          pReader.Close() 
        End Using 
        pMemoryStream.Close() 
      End Using 
    Catch ex As Exception 
      Return pFault.LogException(71, ex, pVariableName, "TRGT-User-150310-1532", vRequester) 
    End Try 
 
    'Run the query 
    pFault = pUser.Update(vRequester, pReload) : If Not pFault.isOK Then Return pFault 
 
    'Get the response 
    If pReload = True Then 
      rResponse = pUser.CreateByteArray(pFault, vRequester) : If Not pFault.isOK Then Return pFault 
    Else 
      rResponse = BitConverter.GetBytes(pUser.ID) 
    End If 
 
    Return pFault 
