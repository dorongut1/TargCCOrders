 'MyConfig
Friend Class MyConfig 
 
  'Use this to enter the config data. This is great if you obfuscate the code   
 
  Friend Enum enmccAPICompressionMode 
    UD 
    IIS 
    DeflateTargCC 
    GzipTargCC 
    None 
  End Enum 
 
  Friend Shared ReadOnly Property WSPwd() As String 
    Get 
      Return "W@Hmav/Ro7" 
    End Get 
  End Property 
 
  Friend Shared ReadOnly Property ccAPICompressionMode() As enmccAPICompressionMode 
    Get 
      Static sccAPICompressionMode As enmccAPICompressionMode 
      If sccAPICompressionMode = enmccAPICompressionMode.UD Then 
        Dim pccAPICompressionMode As String 
        pccAPICompressionMode = MyController.GetConfigValueFromAppSetting("TargCCOrders.ccAPICompressionMode") 
        If pccAPICompressionMode Is Nothing OrElse pccAPICompressionMode = "" Then 
          Throw New Exception(String.Format("Missing or invalid configuration for {0}. TRGT-150314-0922", "TargCCOrders.ccAPICompressionMode")) 
        End If 
        If pccAPICompressionMode.ToLowerInvariant() = ("DeflateTargCC").ToLowerInvariant() Then 
          sccAPICompressionMode = enmccAPICompressionMode.DeflateTargCC 
        ElseIf pccAPICompressionMode.ToLowerInvariant() = ("GzipTargCC").ToLowerInvariant() Then 
          sccAPICompressionMode = enmccAPICompressionMode.GzipTargCC 
        ElseIf pccAPICompressionMode.ToLowerInvariant() = ("IIS").ToLowerInvariant() Then 
          sccAPICompressionMode = enmccAPICompressionMode.IIS 
        ElseIf pccAPICompressionMode.ToLowerInvariant() = ("None").ToLowerInvariant() Then 
          sccAPICompressionMode = enmccAPICompressionMode.None 
        Else 
          sccAPICompressionMode = enmccAPICompressionMode.UD 
          Throw New Exception("TargCCOrders.ccAPICompressionMode must be either 'IIS', 'DeflateTargCC', 'GzipTargCC' or 'None'; TRGT-150314-0924") 
        End If 
      End If 
      Return sccAPICompressionMode 
    End Get 
  End Property 
 
End Class 
