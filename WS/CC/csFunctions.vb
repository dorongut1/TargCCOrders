    Dim pIdent As String 
    Dim pAdditionalMessageToUser As String 
 
    Try 
      Using pMemoryStream As New System.IO.MemoryStream(vRequest) 
        Using pReader As New System.IO.BinaryReader(pMemoryStream) 
          pVariableName = "pFaultNo" 
          pFaultNo = pReader.ReadInt32 
          pVariableName = "pFreeText" 
          pFreeText = pReader.ReadString 
          pVariableName = "pFaultingAssembly" 
          pFaultingAssembly = pReader.ReadString 
          pVariableName = "pFaultingClass" 
          pFaultingClass = pReader.ReadString 
          pVariableName = "pFaultingFunction" 
          pFaultingFunction = pReader.ReadString 
          pVariableName = "pFaultingFunctionParameters" 
          pFaultingFunctionParameters = pReader.ReadString 
          pVariableName = "pIdent" 
          pIdent = pReader.ReadString 
          pVariableName = "pAdditionalMessageToUser" 
          pAdditionalMessageToUser = pReader.ReadString 
          pReader.Close() 
        End Using 
        pMemoryStream.Close() 
      End Using 
    Catch ex As Exception 
      Return pFault.LogException(71, ex, pVariableName, "TRGT-Task-150310-1532", vRequester) 
    End Try 
 
    'Run the query  
    Dim pFaultToWrite As New clsFault 
    Try 
      pFaultToWrite.LogFreeTextFault(pFaultNo, pFreeText, pFaultingFunctionParameters, pIdent, vRequester, vAdditionalMessageToUser:=pAdditionalMessageToUser, vManualFaultingAssembly:=pFaultingAssembly, vManualFaultingClass:=pFaultingClass, vManualFaultingFunction:=pFaultingFunction) 
    Catch ex As Exception 
      Try 
        Tools.LogToTextFile.WriteMessage($"Fatal Error: {ex.Message}{Environment.NewLine}Stack:{ex.ToString}{Environment.NewLine}Original Error:{pFaultToWrite.StringForMessageBox}", "FATAL") 
