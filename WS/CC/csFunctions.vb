  Private Shared Function LoginControllerLogInByNetworkCredentials(ByVal vRequest As Byte(), ByRef rRequester As clsRequester) As clsFault 
    Dim pFunctionParameters As String = "" 
    Dim pFault As New clsFault 
 
    'Get the request  
    Dim pVariableName As String = "" 
    Dim pUILang As clsEnums.enmLanguage 
    Dim pAccessingEntity As csAccessingEntity 
 
    Try 
      Using pMemoryStream As New System.IO.MemoryStream(vRequest) 
        Using pReader As New System.IO.BinaryReader(pMemoryStream, Text.Encoding.UTF8) 
          Dim pLength As Integer 
          Dim pBytes As Byte() 
          pVariableName = "pUILang" 
          pUILang = clsEnums.TranslateEnmLanguage(pReader.ReadString) 
          pVariableName = "pAccessingEntity" 
          pLength = pReader.ReadInt32 
          pBytes = pReader.ReadBytes(pLength) 
          pAccessingEntity = New csAccessingEntity(pBytes, pFault, rRequester) : If Not pFault.isOK Then Return pFault 
          pReader.Close() 
        End Using 
        pMemoryStream.Close() 
      End Using 
    Catch ex As Exception 
      Return pFault.LogException(71, ex, pVariableName, "TRGT-UserStatus-150407-1046", rRequester) 
    End Try 
    
    'Get the User 
    Dim pNetworkCredentialUserName As String = System.Web.HttpContext.Current.Request.LogonUserIdentity.Name 
    If pNetworkCredentialUserName.IndexOf("\") >= 0 Then 
      pNetworkCredentialUserName = pNetworkCredentialUserName.Split("\"c)(1) 
    End If 
 
    'Get the groups the user belongs to 
    Dim pNetworkCredentialRoles As String = "#" 
    For Each pGroup As System.Security.Principal.IdentityReference In System.Web.HttpContext.Current.Request.LogonUserIdentity.Groups 
      Try 
        Dim pStrg As String = pGroup.Translate(GetType(System.Security.Principal.NTAccount)).ToString() 
        If pStrg.IndexOf("\") >= 0 Then 
          pStrg = pStrg.Split("\"c)(1) 
        End If 
        pNetworkCredentialRoles &= pStrg & "#" 
      Catch ex As Exception 
        pNetworkCredentialRoles &= ":" & ex.Message 
      End Try 
    Next 
 
    'Run the query  
    rRequester = Nothing 
    If String.IsNullOrEmpty(pAccessingEntity.WSReportedCountry) Then 
      Dim pOIP As String = System.Web.HttpContext.Current.Request("HTTP_CF_CONNECTING_IP") 
      If pOIP Is Nothing Then 
        pAccessingEntity.WSReportedIP = System.Web.HttpContext.Current.Request("REMOTE_ADDR") 
        pAccessingEntity.WSReportedCountry = "UD" 
      Else 
        pAccessingEntity.WSReportedIP = pOIP 
        pAccessingEntity.WSReportedCountry = System.Web.HttpContext.Current.Request("HTTP_CF_IPCOUNTRY") 
      End If 
    End If 
    pFault = ccSecurity.LogInByNetworkCredentials(rRequester, pUILang, pNetworkCredentialUserName, pNetworkCredentialRoles, pAccessingEntity) : If Not pFault.isOK Then Return pFault 
 
    Return pFault 
  End Function 
