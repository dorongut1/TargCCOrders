  'Login 
  Friend Shared Function DoLogin(ByVal vTask As String, 
                                  ByVal vRequest As Byte(), 
                                  ByRef rRequester As clsRequester) As clsFault 
    Dim pFunctionParameters As String = "" 
 
    Dim pFault As clsFault = Nothing 
 
    Select Case vTask 
      Case "ccSecurityLogInByNamePwd" 
        pFault = LoginControllerLogInByNamePwd(vRequest, rRequester) 
        If Not pFault.isOK Then Return pFault 
      Case "ccSecurityLogInByOTP" 
        pFault = LoginControllerLogInByOTP(vRequest, rRequester) 
        If Not pFault.isOK Then Return pFault 
      Case "ccSecurityLogInByBiometric" 
        pFault = LoginControllerLogInByBiometric(vRequest, rRequester) 
        If Not pFault.isOK Then Return pFault 
      Case "ccSecurityLogInByNetworkCredentials" 
        pFault = LoginControllerLogInByNetworkCredentials(vRequest, rRequester) 
        If Not pFault.isOK Then Return pFault 
      Case "ccSecurityCheck2FactorAuthenticationForLogin" 
        pFault = LoginControllerCheck2FactorAuthenticationForLogin(vRequest, rRequester) 
        If Not pFault.isOK Then Return pFault 
      Case "ccSecurityLogOut" 
        pFault = LoginControllerLogOut(vRequest, rRequester) 
        If Not pFault.isOK Then Return pFault 
      Case Else 
        RaiseEvent evtDoExternalLogin(vTask, vRequest, rRequester, pFault) 
        If pFault Is Nothing Then 
          pFault = New clsFault 
          Return pFault.LogFreeTextFault(71, "Invalid Login Type Received", vTask, "TRGT-190526-1935", rRequester) 
        End If 
    End Select 
 
    Return pFault 
  End Function 
  Private Shared Function LoginControllerLogInByNamePwd(ByVal vRequest As Byte(), ByRef rRequester As clsRequester) As clsFault 
    Dim pFunctionParameters As String = "" 
    Dim pFault As New clsFault 
 
    'Get the request 
    Dim pVariableName As String = "" 
    Dim pUserName As String 
    Dim pPassword As String 
    Dim pUILang As clsEnums.enmLanguage 
    Dim pSendMessageFor2FA As Boolean = False 
    Dim pSendMessageOnPasswordExpiry As Boolean = False 
    Dim pAccessingEntity As csAccessingEntity 
    Dim pNewPassword As String 
 
    Try 
      Using pMemoryStream As New System.IO.MemoryStream(vRequest) 
        Using pReader As New System.IO.BinaryReader(pMemoryStream, Text.Encoding.UTF8) 
          Dim pLength As Integer 
          Dim pBytes As Byte() 
          pVariableName = "pUserName" 
          pUserName = pReader.ReadString 
          pVariableName = "pPassword" 
          pPassword = pReader.ReadString 
          pVariableName = "pUILang" 
          pUILang = clsEnums.TranslateEnmLanguage(pReader.ReadString) 
          pVariableName = "pSendMessageFor2FA" 
          pSendMessageFor2FA = pReader.ReadBoolean 
          pVariableName = "pSendMessageOnPasswordExpiry" 
          pSendMessageOnPasswordExpiry = pReader.ReadBoolean 
          pVariableName = "pAccessingEntity" 
          pLength = pReader.ReadInt32 
          pBytes = pReader.ReadBytes(pLength) 
          pAccessingEntity = New csAccessingEntity(pBytes, pFault, rRequester) : If Not pFault.isOK Then Return pFault 
          pVariableName = "pNewPassword" 
          pNewPassword = pReader.ReadString 
          pReader.Close() 
        End Using 
        pMemoryStream.Close() 
      End Using 
    Catch ex As Exception 
      Return pFault.LogException(71, ex, pVariableName, "TRGT-UserStatus-150310-1532", rRequester) 
    End Try 
 
    'Run the query 
    rRequester = Nothing 
    If String.IsNullOrEmpty(pAccessingEntity.WSReportedCountry) Then 
      Dim pOIP As String = System.Web.HttpContext.Current.Request("HTTP_CF_CONNECTING_IP") 
      If pOIP Is Nothing Then 
        pAccessingEntity.WSReportedIP = System.Web.HttpContext.Current.Request("REMOTE_ADDR") 
        pAccessingEntity.WSReportedCountry = "UD" 
      Else 
        pAccessingEntity.WSReportedIP = pOIP 
        pAccessingEntity.WSReportedCountry = System.Web.HttpContext.Current.Request("HTTP_CF_IPCOUNTRY") 
      End If 
    End If 
    pFault = ccSecurity.LogInByNamePwd(pUserName, pPassword, rRequester, vOverrideUILang:=pUILang, vSendMessageFor2FA:=pSendMessageFor2FA, vSendMessageOnPasswordExpiry:=pSendMessageOnPasswordExpiry, vAccessingEntity:=pAccessingEntity, vNewPassword:=pNewPassword) : If Not pFault.isOK Then Return pFault 
 
    Return pFault 
  End Function 
