<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TargCCOrders.WebAPIHost</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <!-- .NET Framework compatibility packages for DBController -->
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.1" />
    <PackageReference Include="System.Data.SqlClient" Version="4.8.6" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
    <PackageReference Include="Microsoft.VisualBasic" Version="10.3.0" />
  </ItemGroup>

  <!-- Reference the WebAPI controllers library -->
  <!-- Adjust path to match your DBController build output -->
  <ItemGroup>
    <Compile Include="..\WebAPI\Controllers\*.cs" LinkBase="Controllers" />
    <Compile Include="..\WebAPI\Dtos\*.cs" LinkBase="Dtos" />
  </ItemGroup>

  <!-- app.config for DBController (System.Configuration.ConfigurationManager) -->
  <ItemGroup>
    <None Update="app.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Reference the VB.NET Data Layer -->
  <ItemGroup>
    <ProjectReference Include="..\DBController\DBController.vbproj"
                      Condition="Exists('..\DBController\DBController.vbproj')" />
  </ItemGroup>

</Project>
